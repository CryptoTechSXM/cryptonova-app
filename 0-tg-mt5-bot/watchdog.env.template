# ── watchdog.env ──────────────────────────────────────────────────────────────
# Copy this file to watchdog.env and fill in your values.
# These are the same credentials used by your bots' .env files.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=YOUR_API_ID_HERE
TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# The Telethon session name (watchdog saves its own session file)
TELEGRAM_SESSION=watchdog_session

# The chat where watchdog alerts will be sent (same as your bots' SIGNAL_CHAT_ID)
SIGNAL_CHAT_ID=YOUR_SIGNAL_CHAT_ID_HERE
