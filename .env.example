# ─── CryptoNova Deploy Environment ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — add it to .gitignore immediately.

# Deployer wallet private key (starts with 0x)
# Use a dedicated deploy wallet — not your main wallet.
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# Wallet that receives the $0.30/entry dev fee
DEV_WALLET_ADDRESS=0xyour_dev_wallet_here

# Wallet that receives the $0.20/entry ops fee
OPS_WALLET_ADDRESS=0xyour_ops_wallet_here

# ─── Base Chain (primary) ─────────────────────────────────────────────────────

# Base Mainnet native USDC (Circle — 6 decimals on Base)
# ⚠️ Confirm decimals before deploy: Base USDC uses 6 dec, not 18!
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Base RPC endpoints
# Free public:  https://mainnet.base.org  (rate-limited)
# Recommended:  Alchemy or QuickNode Base endpoint for production
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# BaseScan API key — get free at https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key_here

# ─── BNB Chain (secondary — future expansion) ─────────────────────────────────
# Uncomment and fill in when deploying the BSC version

# BSC_RPC_URL=https://bsc-dataseed.binance.org/
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
# BSCSCAN_API_KEY=your_bscscan_api_key_here
# BSC USDC (18 decimals — different from Base!):
# USDC_ADDRESS=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
