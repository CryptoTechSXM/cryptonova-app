; CNMS_MACD_Adaptive — MT5 Strategy Tester OPTIMISATION SWEEP
; ─────────────────────────────────────────────────────────────────
; HOW TO USE:
;   1. Open MT5 Strategy Tester  (View → Strategy Tester  or  Ctrl+R)
;   2. Expert Advisor  → CNMS_MACD_Adaptive
;   3. Symbol          → BTCUSD   Timeframe → H1
;   4. Model           → Every tick based on real ticks (or OHLC for speed)
;   5. Date range      → Set at least 1 year of history
;   6. Optimisation    → Slow complete algorithm  OR  Genetic algorithm (faster)
;   7. Inputs tab      → Load → select THIS file
;   8. Click Start
;
; FORMAT per line:  ParameterName=Value||Start||Step||Stop||Optimise(true/false)
; ─────────────────────────────────────────────────────────────────

; ── MACD (sweep fast period and signal)
InpMacdFast=12||8||2||16||true
InpMacdSlow=26||21||3||30||false
InpMacdSignal=9||5||2||9||true
InpMacdPrice=0||0||0||0||false

; ── Timeframes (fixed — change manually between runs if needed)
InpTrendTF=16408||16408||0||0||false
InpEntryTF=16385||16385||0||0||false

; ── ATR
InpAtrPeriod=14||10||2||20||false

; ── Risk multipliers (the most impactful parameters to sweep)
InpSlMulti=1.0||0.8||0.2||2.0||true
InpTpMulti=2.0||1.5||0.5||4.0||true
InpTrailStart=0.8||0.5||0.3||1.5||true
InpTrailDist=0.8||0.5||0.3||1.5||false
InpTrailStep=0.3||0.3||0||0||false

; ── Fixed / not swept
InpMagicNumber=202600||202600||0||0||false
InpLotSize=0.01||0.01||0||0||false
InpSlippage=50||50||0||0||false
InpMaxPositions=1||1||0||0||false
InpAdoptManual=true||true||0||0||false
InpAlertOnAdopt=false||false||0||0||false
InpOverrideSL=false||false||0||0||false
InpOverrideTP=false||false||0||0||false
