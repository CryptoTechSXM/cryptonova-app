"""
main.py -- Gold HA Bot
======================
  - Calls check_signal() from strategy.py
  - Uses bot/manager.py for position management (trail + TP removal)
  - Keeps adopt_manual_trades for manual trade adoption

Scan loop runs every CHECK_INTERVAL seconds (5s):
  - adopt_manual_trades()  -- every scan
  - manage_positions()     -- every scan  (trail fires at 5s resolution)
  - check_signal()         -- new M1 candle only
"""

import os
import time
import MetaTrader5 as mt5
import pandas as pd

import config
from bot.logger      import log, log_trade
from bot.adopter     import adopt_manual_trades
from bot.manager     import manage_positions, session_close_guard
from strategy        import check_signal
from signal_bridge   import apply_signal_bridge
from telegram_sender import send_signal, send_close, send_status
from resolver          import resolve_symbol

SILENT        = os.getenv("SILENT_MODE", "false").lower() == "true"
STRATEGY_NAME = "Gold HA Bot"


def _local(utc_h, utc_m=0):
    from datetime import datetime
    off  = int((datetime.now() - datetime.utcnow()).total_seconds() / 60)
    mins = utc_h * 60 + utc_m + off
    tz   = datetime.now().astimezone().strftime('%Z')
    return "{:02d}:{:02d} {}".format((mins // 60) % 24, mins % 60, tz)


# -- State --
last_candle_time = None
last_trade_time  = 0
daily_trades     = 0
daily_date       = None
closed_tickets   = set()   # tickets already logged — prevents double-counting


def get_data(symbol, timeframe_min, bars=200):
    tf_map = {1: mt5.TIMEFRAME_M1, 5: mt5.TIMEFRAME_M5, 60: mt5.TIMEFRAME_H1}
    tf     = tf_map.get(timeframe_min)
    if tf is None:
        return None
    rates = mt5.copy_rates_from_pos(symbol, tf, 0, bars)
    if rates is None or len(rates) == 0:
        return None
    df = pd.DataFrame(rates)
    df['time'] = pd.to_datetime(df['time'], unit='s')
    return df[['time', 'open', 'high', 'low', 'close']]


def place_order(symbol, direction, sl, tp):
    """Simple market order using signal SL and TP."""
    tick = mt5.symbol_info_tick(symbol)
    info = mt5.symbol_info(symbol)
    if not tick or not info:
        return None

    spread_pts = (tick.ask - tick.bid) / info.point if info.point > 0 else 0
    if spread_pts > config.MAX_SPREAD:
        log("{}: spread {:.0f} pts > {} -- skipping".format(symbol, spread_pts, config.MAX_SPREAD))
        return None

    price = tick.ask if direction == 'BUY' else tick.bid
    dist  = abs(price - sl)
    if dist <= 0:
        return None

    acc = mt5.account_info()
    if not acc:
        return None
    tick_val = info.trade_tick_value
    tick_sz  = info.trade_tick_size
    if tick_val <= 0 or tick_sz <= 0:
        return None
    risk_usd = acc.balance * (config.RISK_PERCENT / 100)
    lot = round(risk_usd / (dist / tick_sz * tick_val), 2)
    lot = max(info.volume_min, min(info.volume_max, lot))

    req = {
        'action':       mt5.TRADE_ACTION_DEAL,
        'symbol':       symbol,
        'volume':       lot,
        'type':         mt5.ORDER_TYPE_BUY if direction == 'BUY' else mt5.ORDER_TYPE_SELL,
        'price':        price,
        'sl':           sl,
        'tp':           tp,
        'magic':        config.MAGIC_NUMBER,
        'comment':      'Gold HA Bot',
        'type_time':    mt5.ORDER_TIME_GTC,
        'type_filling': mt5.ORDER_FILLING_IOC,
    }
    return mt5.order_send(req)


_tracked_positions = {}   # ticket → {direction, entry, sl} for broker-close detection


def track_open_positions(positions):
    """Detect positions closed by broker (SL/TP hit) and log them to trade_log.csv."""
    global _tracked_positions
    current_tickets = {p.ticket for p in (positions or [])}
    vanished = {t: info for t, info in _tracked_positions.items() if t not in current_tickets}
    for ticket, info in vanished.items():
        if ticket in closed_tickets:
            _tracked_positions.pop(ticket, None)
            continue
        from datetime import datetime, timezone, timedelta
        since = datetime.now(timezone.utc) - timedelta(hours=24)
        deals = mt5.history_deals_get(since, datetime.now(timezone.utc))
        exit_price = None
        profit_usd = 0.0
        if deals:
            closing = [d for d in deals if d.position_id == ticket and d.entry in (1, 3)]
            if closing:
                best = max(closing, key=lambda d: d.time)
                exit_price = best.price
                profit_usd = best.profit
        direction = info['direction']
        entry     = info['entry']
        sl        = info['sl']
        if exit_price is None:
            log(f'[{config.SYMBOL}] BROKER-CLOSE #{ticket} {direction} — no deal found in history')
        else:
            diff = (exit_price - entry) if direction == 'BUY' else (entry - exit_price)
            sl_dist = abs(entry - sl) if sl and sl != entry else 0
            result_r = diff / sl_dist if sl_dist > 0 else 0
            tag = 'TP' if profit_usd > 0.01 else ('SL' if profit_usd < -0.01 else 'BE')
            log(f'[{config.SYMBOL}] BROKER-CLOSE #{ticket} {direction} {tag} '
                f'entry={entry:.2f} exit={exit_price:.2f} P&L={profit_usd:+.2f} ({result_r:+.2f}R)')
            log_trade({
                "time":      __import__('datetime').datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "symbol":    config.SYMBOL,
                "direction": direction,
                "entry":     round(entry, 2),
                "sl":        round(sl, 2) if sl else "",
                "lot":       "",
                "ticket":    ticket,
                "exit":      round(exit_price, 2),
                "rr":        round(result_r, 2),
                "outcome":   "WIN" if profit_usd > 0.01 else ("LOSS" if profit_usd < -0.01 else "BE"),
            })
            send_close(config.SYMBOL, direction, entry, exit_price, result_r, STRATEGY_NAME)
        closed_tickets.add(ticket)
    _tracked_positions = {
        p.ticket: {
            'direction': 'BUY' if p.type == 0 else 'SELL',
            'entry': p.price_open,
            'sl': p.sl,
        }
        for p in (positions or [])
    }


def connect_mt5(max_retries=5, wait=10):
    for attempt in range(1, max_retries + 1):
        try:
            if not mt5.initialize():
                raise RuntimeError("MT5 init failed: {}".format(mt5.last_error()))
            config.SYMBOL = resolve_symbol(config.BASE_SYMBOL)
            acc = mt5.account_info()
            log('=' * 55)
            log('  GOLD HA BOT  (Basic M1 Strategy)')
            log('  Asset       : {}'.format(config.SYMBOL))
            log('  EMA         : {}'.format(config.EMA_PERIOD))
            log('  Session     : 07:00-21:00 UTC  ({}-{} local)'.format(_local(7), _local(21)))
            log('  Risk/trade  : {}% | Max DD: {}%'.format(config.RISK_PERCENT, config.MAX_DAILY_LOSS_PCT))
            log('  Daily limit : {} trades | cooldown {}s'.format(config.MAX_DAILY_TRADES, config.TRADE_COOLDOWN))
            log('  Max spread  : {} pts'.format(config.MAX_SPREAD))
            log('  ATR filter  : {} < ATR < {} pts'.format(config.MIN_ATR, config.MAX_ATR))
            log('  Session buf : No entries {}min before London/NY close'.format(config.SESSION_CLOSE_BUFFER))
            log('  Trail       : {:.0%} ATR trigger | {:.0%} ATR buffer | TP removed at BE'.format(
                config.TRAIL_ATR_TRIGGER, config.TRAIL_ATR_BUFFER))
            if acc:
                log('     Login   : {}'.format(acc.login))
                log('     Server  : {}'.format(acc.server))
                log('     Balance : ${:,.2f}'.format(acc.balance))
                log('     Equity  : ${:,.2f}'.format(acc.equity))
            log('=' * 55)
            send_status(STRATEGY_NAME, 'ONLINE')
            return True
        except Exception as e:
            log('MT5 attempt {}/{}: {}'.format(attempt, max_retries, e))
            time.sleep(wait)
    return False


def run_bot():
    global last_candle_time, last_trade_time, daily_trades, daily_date
    from datetime import date

    if not connect_mt5():
        return

    sym = config.SYMBOL
    log('Bot running on {}'.format(sym))

    try:
        while True:
            try:
                # Reset daily counter at midnight
                today = date.today()
                if daily_date != today:
                    daily_date   = today
                    daily_trades = 0

                # Fetch market data
                df_m1 = get_data(sym, 1,  bars=200)
                df_m5 = get_data(sym, 5,  bars=100)
                df_h1 = get_data(sym, 60, bars=50)

                if df_m1 is None or df_m5 is None or df_h1 is None:
                    log('{}: data fetch failed (MT5 disconnected?) — retrying in {}s'.format(
                        sym, config.CHECK_INTERVAL))
                    time.sleep(config.CHECK_INTERVAL)
                    continue

                # -- Every scan (5s): adopt + manage + session guard --
                adopt_manual_trades()
                manage_positions({})
                session_close_guard(sym)
                try:
                    open('heartbeat.txt', 'w').write(__import__('time').strftime('%s') if hasattr(__import__('time'), 'strftime') else str(__import__('time').time()))
                except Exception:
                    pass

                # -- New candle only: signal check --
                ct = df_m1.iloc[-1]['time']
                if last_candle_time == ct:
                    time.sleep(config.CHECK_INTERVAL)
                    continue
                last_candle_time = ct

                # Skip if already in a position
                positions = mt5.positions_get(symbol=sym)
                track_open_positions(positions)   # detect broker-closed (SL/TP) and log them
                if positions:
                    time.sleep(config.CHECK_INTERVAL)
                    continue

                # Daily trade cap
                if daily_trades >= config.MAX_DAILY_TRADES:
                    time.sleep(config.CHECK_INTERVAL)
                    continue

                # Cooldown between trades
                elapsed = time.time() - last_trade_time
                if elapsed < config.TRADE_COOLDOWN:
                    time.sleep(config.CHECK_INTERVAL)
                    continue

                # Check signal
                signal = check_signal(df_m1, df_m5, df_h1, config)

                if signal:
                    # Cross-confirm with Free Signals bridge before executing
                    signal = apply_signal_bridge(signal, sym)

                if signal:
                    bridge_tag = ' [BRIDGE✅]' if signal.get('bridge_confirmed') else ''
                    log('{}: SIGNAL {}{} | SL={:.2f} TP={:.2f}'.format(
                        sym, signal['type'], bridge_tag, signal['sl'], signal['tp']))
                    result = place_order(sym, signal['type'], signal['sl'], signal['tp'])

                    if result and result.retcode == mt5.TRADE_RETCODE_DONE:
                        sl_dist = abs(result.price - signal['sl'])
                        tp_dist = abs(signal['tp'] - result.price)
                        rr = round(tp_dist / sl_dist, 2) if sl_dist > 0 else 1.0
                        log('{}: Order filled ticket={} @ {:.2f}'.format(
                            sym, result.order, result.price))
                        last_trade_time = time.time()
                        daily_trades   += 1
                        send_signal(sym, signal['type'], result.price,
                                    signal['sl'], signal['tp'], STRATEGY_NAME, rr=rr)
                    else:
                        log('{}: Order failed: {}'.format(sym, result))
                else:
                    if not SILENT:
                        log("{}: No signal this candle".format(sym))
            except Exception as e:
                log('Error: {}'.format(e))

            time.sleep(config.CHECK_INTERVAL)

    except KeyboardInterrupt:
        log('Bot stopped')
    finally:
        mt5.shutdown()
        log('MT5 shutdown')
        send_status(STRATEGY_NAME, 'STOPPED')


if __name__ == '__main__':
    run_bot()
